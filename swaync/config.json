{
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "layer-shell": true,
    "control-center-margin-top": 14,
    "control-center-margin-bottom": 0,
    "control-center-margin-left": 0,
    "control-center-margin-right": 14,
    "cssPriority": "user",
    "notification-icon-size": 64,
    "notification-width": 380,
    "notification-2fa-action": true,
    "timeout": 3,
    "timeout-low": 3,
    "timeout-critical": 0,
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "fit-to-screen": false,
    "control-center-height": 700,
    "control-center-width": 500,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "widgets": [
        "volume",
        "mpris",
        "backlight",
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "mpris": {
            "image-size": 50,
            "image-radius": 0
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "volume": {
            "label": "\uf028"
        },
        "backlight": {
            "label": "\udb80\udcdf"
        }
    },
    "scripts": {
        "notification-received": {
            "exec": "paplay /usr/share/sounds/freedesktop/stereo/message.oga"
        }
    }
}